{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BrowserRoute",
  "version": "0.1.0",
  "identifier": "dev.browserroute.app",
  "build": { "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build", "devUrl": "http://localhost:1420", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "BrowserRoute", "width": 1180, "height": 760, "minWidth": 900, "minHeight": 620 }], "security": { "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline';" } },
  "bundle": { "active": false, "targets": "all", "icon": ["icons/icon.ico", "icons/icon.icns", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"] }
}
